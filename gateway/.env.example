# Server
PORT=5000
NODE_ENV=development

# JWT — MUST be a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=!234567890qwertyuiopasdfghjklzxcvbnm@#$%^&*()_+

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# CORS — comma-separated list of allowed origins
# e.g. CORS_ORIGINS=https://myapp.com,https://admin.myapp.com
# Leave empty to allow all origins in development
CORS_ORIGINS=http://localhost:3000
