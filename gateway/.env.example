# Server
PORT=
NODE_ENV=

# JWT — MUST be a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes, in seconds
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# CORS — comma-separated list of allowed origins
# e.g. CORS_ORIGINS=https://myapp.com,https://admin.myapp.com
# Leave empty to allow all origins in development
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=

# INTERNAL_SERVICE_SECRET=secret-gateway-service_provider
INTERNAL_SERVICE_SECRET=